# InnoDB tuned for HammerDB TPROC-C throughput (NOPM), used by --profile=fast.
#
# Durability: a commit survives a mariadbd crash but not an OS crash or power
# loss — the redo log is written at commit and flushed about once a second.
# Unlike innodb.cnf, the rest is tuned too, so acid and fast differ in more
# than durability. Sized for ~70 warehouses on a 31 GiB host running one
# engine at a time; HammerDB runs on the same host.
[mariadbd]
# Durability: InnoDB's equivalent of ByteCaskDB's bytecaskdb_sync = AT_INTERVAL.
innodb_flush_log_at_trx_commit = 2
innodb_flush_log_at_timeout    = 1
# Guards against torn pages on an OS crash, which this profile already gives up.
innodb_doublewrite             = OFF

# Memory: hold the whole dataset (~7 GB at 70 warehouses, growing as orders
# are inserted) so the run is bound by CPU, not by buffer pool misses.
innodb_buffer_pool_size        = 16G
# No O_DIRECT: data files and redo go through the page cache, which backs the
# buffer pool as a second-level cache, as it does for bytecaskdb-fast.cnf.
innodb_flush_method            = fsync
innodb_log_file_buffering      = ON

# Redo: a large log defers checkpoint flushing; a larger buffer absorbs the
# commit rate between once-a-second flushes.
innodb_log_file_size           = 4G
innodb_log_buffer_size         = 64M

# Page flushing: SSD, so no neighbour flushing; enough I/O budget that dirty
# pages are written in the background rather than on the commit path.
innodb_flush_neighbors         = 0
innodb_io_capacity             = 4000
innodb_io_capacity_max         = 8000
innodb_max_dirty_pages_pct     = 90
innodb_write_io_threads        = 8
innodb_read_io_threads         = 8
innodb_purge_threads           = 4

performance_schema             = OFF
skip-log-bin
sync_binlog                    = 0
table_open_cache               = 2000
thread_cache_size              = 32
max_connections                = 64
