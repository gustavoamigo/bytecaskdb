[mariadbd]
bytecaskdb_io_backend = buffer_pool
# Memory: the same 3 GiB as innodb.cnf's innodb_buffer_pool_size, so the acid
# profile compares the engines, not their cache sizes. At 1 GiB, sysbench's
# 5M-row table missed the pool 266K times a second on the 48-vCPU box, and
# the run measured O_DIRECT reads (36% iowait against InnoDB's 0.3%).
bytecaskdb_buffer_pool_size = 3221225472
bytecaskdb_max_file_bytes = 67108864
bytecaskdb_verify_checksums = OFF
# Vacuum: the engine's default. With the pool smaller than the files, the
# pool has to hold every frame still holding a live record, and that is the
# file bytes vacuum has not reclaimed (benchmarks/pool_model, #296).
bytecaskdb_vacuum_fragmentation_threshold = 0.5
bytecaskdb_vacuum_busy_interval_ms = 1000
bytecaskdb_vacuum_idle_interval_ms = 30000
