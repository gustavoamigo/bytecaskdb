# bcdboltp.tcl — HammerDB 6.0's TPROC-C driver for ByteCaskDB's SQL layer
# (docs/procedures_design.md, *Phases*, 4c), run as a custom script. Its logic
# is HammerDB 6.0's PostgreSQL stored-procedure driver's
# (src/postgresql/pgoltp.tcl, pg_storedprocs true, the timed driver): each
# virtual user draws a transaction from the same deck with the same inputs and
# sends it as one CALL of a procedure of hammerdb/tprocc_procs.sql, which runs
# the transaction on the server; the monitor counts transactions from
# pg_stat_database and New-Orders from d_next_o_id. Only the call syntax is the
# layer's: arguments in the procedures' order, the time as a timestamp
# literal, and Payment's history key, which the driver draws.
#
# Run by hammerdb/run-gate.sh, which writes the OPTIONS below: hammerdbcli
# with `dbset db pg`, `customscript` this file. Virtual user 1 is the
# monitor; the others run transactions.
#OPTIONS
set total_iterations 10000000 ;# Transactions per virtual user before it stops
set RAISEERROR "false" ;# Stop a virtual user at its first error (true or false)
set rampup 2 ;# Minutes before the first count
set duration 5 ;# Minutes between the two counts
set host "127.0.0.1" ;# sql_layer_server's address
set port "5432" ;# and port
set user "tprocc" ;# Any name: trust authentication
set db "tprocc" ;# The database name the server serves
set warehouses 1 ;# Warehouses loaded
set items 100000 ;# Items loaded: New-Order draws its items from 1 to this
set run 1 ;# The harness_run the run script took for this cell: the h_ids' top bits
set mix {neword payment ostat delivery slev} ;# Transaction types to run
set engine "ByteCaskDB" ;# The name HammerDB's result line gives the system
#OPTIONS

#LOAD LIBRARIES AND MODULES
if [catch {package require Pgtcl} message] { error "Failed to load Pgtcl - $message" }
if [catch {package require tpcccommon} ] { error "Failed to load HammerDB's tpcccommon functions" } else { namespace import tpcccommon::* }

if { [ chk_thread ] eq "FALSE" } {
    error "PostgreSQL TPROC-C needs threaded Tcl: run it in HammerDB"
}

proc connect { host port user db } {
    return [ pg_connect -conninfo "host=$host port=$port user=$user dbname=$db sslmode=disable gssencmode=disable" ]
}

# The time as the procedures take it, a TIMESTAMP literal.
proc now {} { return [ clock format [ clock seconds ] -format "%Y-%m-%d %H:%M:%S" ] }

# One CALL, and its outcome counted for the monitor's error line: a failed
# call is not retried, as HammerDB's drivers do not retry. New-Order's 1%
# unused item fails its call with P0002 (no_data_found), which rolls it back,
# as the benchmark asks: counted as a rollback, not an error.
proc call { conn raise sql } {
    set r [ pg_exec $conn $sql ]
    set status [ pg_result $r -status ]
    if { $status in {"PGRES_TUPLES_OK" "PGRES_COMMAND_OK"} } {
        pg_result $r -clear
        return
    }
    set state [ pg_result $r -error sqlstate ]
    set message [ pg_result $r -error ]
    pg_result $r -clear
    if { $state eq "P0002" && [ string match "call neword(*" $sql ] } { return }
    tsv::lock errors {
        if { ![ tsv::exists errors $state ] } { tsv::set errors $state 0 }
        tsv::incr errors $state
    }
    if { $raise } { error "$message" } else { puts "$message" }
}

#NEW ORDER
proc neword { conn raise no_w_id w_id_input items } {
    #2.4.1.2 select district id randomly from home warehouse where d_w_id = d_id
    set no_d_id [ RandomNumber 1 10 ]
    #2.4.1.2 Customer id randomly selected where c_d_id = d_id and c_w_id = w_id
    set no_c_id [ RandomNumber 1 3000 ]
    #2.4.1.3 Items in the order randomly selected from 5 to 15
    set ol_cnt [ RandomNumber 5 15 ]
    #2.4.1.6 order entry date O_ENTRY_D generated by SUT
    set date [ now ]
    call $conn $raise "call neword($no_w_id,$w_id_input,$no_d_id,$no_c_id,$ol_cnt,$items,NULL,NULL,NULL,NULL,NULL,NULL,'$date')"
}

#PAYMENT
proc payment { conn raise p_w_id w_id_input hid } {
    #2.5.1.1 select district id randomly from home warehouse where d_w_id = d_id
    set p_d_id [ RandomNumber 1 10 ]
    #2.5.1.2 customer selected 60% of time by name and 40% of time by number
    set x [ RandomNumber 1 100 ]
    set y [ RandomNumber 1 100 ]
    if { $x <= 85 } {
        set p_c_d_id $p_d_id
        set p_c_w_id $p_w_id
    } else {
        #use a remote warehouse
        set p_c_d_id [ RandomNumber 1 10 ]
        set p_c_w_id [ RandomNumber 1 $w_id_input ]
        while { ($p_c_w_id == $p_w_id) && ($w_id_input != 1) } {
            set p_c_w_id [ RandomNumber 1 $w_id_input ]
        }
    }
    set nrnd [ NURand 255 0 999 123 ]
    set name [ randname $nrnd ]
    set p_c_id [ RandomNumber 1 3000 ]
    if { $y <= 60 } {
        set byname 1
        set p_c_id NULL
    } else {
        set byname 0
    }
    #2.5.1.3 random amount from 1 to 5000
    set p_h_amount [ RandomNumber 1 5000 ]
    #2.5.1.4 date selected from SUT
    set h_date [ now ]
    call $conn $raise "call payment($p_w_id,$p_d_id,$p_c_w_id,$p_c_d_id,$byname,$p_h_amount,$p_c_id,'$name',NULL,NULL,$hid,'$h_date')"
}

#ORDER_STATUS
proc ostat { conn raise w_id } {
    set d_id [ RandomNumber 1 10 ]
    set nrnd [ NURand 255 0 999 123 ]
    set name [ randname $nrnd ]
    set c_id [ RandomNumber 1 3000 ]
    set y [ RandomNumber 1 100 ]
    if { $y <= 60 } {
        set byname 1
        set c_id NULL
    } else {
        set byname 0
    }
    call $conn $raise "call ostat($w_id,$d_id,$c_id,$byname,'$name',NULL,NULL,NULL,NULL,NULL)"
}

#DELIVERY
proc delivery { conn raise w_id } {
    set carrier_id [ RandomNumber 1 10 ]
    set date [ now ]
    call $conn $raise "call delivery($w_id,$carrier_id,'$date')"
}

#STOCK LEVEL
proc slev { conn raise w_id stock_level_d_id } {
    set threshold [ RandomNumber 10 20 ]
    call $conn $raise "call slev($w_id,$stock_level_d_id,$threshold,NULL)"
}

# HammerDB's timed monitor, as pgoltp.tcl's: TPM from pg_stat_database's
# transaction count, NOPM from the sum of d_next_o_id.
proc monitor { host port user db rampup duration totalvirtualusers engine } {
    set conn [ connect $host $port $user $db ]
    puts "Beginning rampup time of $rampup minutes"
    set ramptime 0
    set rampup [ expr { $rampup * 60000 } ]
    while { $ramptime != $rampup } {
        if { [ tsv::get application abort ] } { break } else { after 6000 }
        set ramptime [ expr { $ramptime + 6000 } ]
        if { ![ expr { $ramptime % 60000 } ] } { puts "Rampup [ expr { $ramptime / 60000 } ] minutes complete ..." }
    }
    if { [ tsv::get application abort ] } { return }
    puts "Rampup complete, Taking start Transaction Count."
    pg_select $conn "select sum(xact_commit + xact_rollback) from pg_stat_database" tx_arr { set start_trans $tx_arr(sum) }
    pg_select $conn "select sum(d_next_o_id) from district" o_id_arr { set start_nopm $o_id_arr(sum) }
    puts "Timing test period of $duration in minutes"
    set testtime 0
    set durmin $duration
    set duration [ expr { $duration * 60000 } ]
    while { $testtime != $duration } {
        if { [ tsv::get application abort ] } { break } else { after 6000 }
        set testtime [ expr { $testtime + 6000 } ]
        if { ![ expr { $testtime % 60000 } ] } { puts -nonewline "[ expr { $testtime / 60000 } ]  ...," }
    }
    if { [ tsv::get application abort ] } { return }
    puts "Test complete, Taking end Transaction Count."
    pg_select $conn "select sum(xact_commit + xact_rollback) from pg_stat_database" tx_arr { set end_trans $tx_arr(sum) }
    pg_select $conn "select sum(d_next_o_id) from district" o_id_arr { set end_nopm $o_id_arr(sum) }
    set tpm [ expr { ($end_trans - $start_trans) / $durmin } ]
    set nopm [ expr { ($end_nopm - $start_nopm) / $durmin } ]
    puts "[ expr { $totalvirtualusers - 1 } ] Active Virtual Users configured"
    puts [ testresult $nopm $tpm $engine ]
    set errors {}
    if { "errors" in [ tsv::names ] } {
        foreach state [ lsort [ tsv::array names errors ] ] { lappend errors "$state=[ tsv::get errors $state ]" }
    }
    puts "Errors by SQLSTATE: [ expr { [ llength $errors ] ? [ join $errors { } ] : {none} } ]"
    tsv::set application abort 1
    catch { pg_disconnect $conn }
}

set rema [ lassign [ findvuposition ] myposition totalvirtualusers ]
switch $myposition {
    1 { monitor $host $port $user $db $rampup $duration $totalvirtualusers $engine }
    default {
        set conn [ connect $host $port $user $db ]
        # A home warehouse fixed by position (docs/server_design.md, *The
        # HammerDB driver*); HammerDB's random one draws correlated numbers
        # across users.
        set w_id [ expr { ($myposition - 2) % $warehouses + 1 } ]
        set stock_level_d_id [ RandomNumber 1 10 ]
        set raise [ string is true -strict $RAISEERROR ]
        set n 0
        puts "Processing $total_iterations transactions with output suppressed..."
        for {set it 0} {$it < $total_iterations} {incr it} {
            if { [ tsv::get application abort ] } { break }
            set choice [ RandomNumber 1 23 ]
            set kind [ expr { $choice <= 10 ? "neword" : $choice <= 20 ? "payment" : $choice == 21 ? "delivery" : $choice == 22 ? "slev" : "ostat" } ]
            if { [ lsearch -exact $mix $kind ] < 0 } { continue }
            switch $kind {
                neword { neword $conn $raise $w_id $warehouses $items }
                payment {
                    # h_id: the harness's scheme, the position as the thread.
                    set hid [ expr { ($run << 48) | ($myposition << 40) | $n } ]
                    incr n
                    payment $conn $raise $w_id $warehouses $hid
                }
                delivery { delivery $conn $raise $w_id }
                slev { slev $conn $raise $w_id $stock_level_d_id }
                ostat { ostat $conn $raise $w_id }
            }
        }
        catch { pg_disconnect $conn }
    }
}
