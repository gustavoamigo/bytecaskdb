{
  "name": "bytecaskdb",
  "version": "0.1.0",
  "description": "ByteCaskDB embedded key-value store for Node.js",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:wasm": "cd .. && xmake build wasm_embind",
    "build:wasm:all": "cd .. && xmake build wasm_embind && xmake build wasm_smoke_test && xmake build wasm_engine_bench && xmake build wasm_memory_profile && xmake build wasm_tests",
    "build:native": "cd .. && xmake build bytecaskdb_node",
    "build:ts": "tsc",
    "build": "npm run build:wasm && npm run build:native && npm run build:ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:smoke": "cd .. && xmake build wasm_smoke_test && node bytecaskdb-node/wasm/build/wasm_smoke_test.js",
    "test:smoke:native": "npm run build:native && node native/smoke_test.cjs",
    "test:wasm": "cd .. && xmake build wasm_tests && node bytecaskdb-node/wasm/build/bytecask_tests.js '~[concurrency]' '~[lock]'",
    "bench:wasm": "cd .. && xmake build wasm_engine_bench && BC_DATASET_SIZE=100000 node bytecaskdb-node/wasm/build/engine_bench_nodefs.js",
    "bench": "npm run build:ts && node scripts/bench.mjs"
  },
  "files": [
    "dist/",
    "wasm/build/bytecask.mjs",
    "wasm/build/bytecask.wasm",
    "native/bytecask.node"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "node-addon-api": "^8.9.2",
    "node-api-headers": "^1.9.0",
    "tinybench": "^6.2.0",
    "typescript": "^5.4",
    "vitest": "^5.0.0"
  }
}
