An ingest whose append_entries fails, with no memory to publish the degraded
state, leaves the engine writable with the chunks it wrote in the file, and a
std::bad_alloc in the I/O error's place. Reverts #618.
Guarded-by: "alloc sweep: ingest whose append fails"

diff --git a/bytecaskdb/db_replication.cpp b/bytecaskdb/db_replication.cpp
index 0eac211..0ab8bf4 100644
--- a/bytecaskdb/db_replication.cpp
+++ b/bytecaskdb/db_replication.cpp
@@ -406,10 +406,10 @@ void DB::ingest(const ChangeHeader &header,
       } catch (...) {
         auto ex = std::current_exception();
         try { file.sync(); } catch (...) {}
-        degrade_or_refuse([&] {
+        [&] {
           store_state(current->degraded_copy(
               "ingest append IO error: call resume() to recover."));
-        });
+        }();
         std::rethrow_exception(ex);
       }
       appended = true;
