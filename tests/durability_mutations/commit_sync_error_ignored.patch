A failed commit fdatasync is ignored: the flush publishes the head and
advances durable_seq as if it had succeeded. Reverts BC-155 / BC-163.
Guarded-by: "class F: key not visible after commit sync failure"

diff --git a/bytecaskdb/db_commit.cpp b/bytecaskdb/db_commit.cpp
index 07f87ad..2631d56 100644
--- a/bytecaskdb/db_commit.cpp
+++ b/bytecaskdb/db_commit.cpp
@@ -375,9 +375,6 @@ void DB::flush_pending() {
       static_cast<WritableDataFile &>(head->active_file()).sync();
       counters_.fsyncs.fetch_add(1, std::memory_order_relaxed);
     } catch (...) {
-      flush_failed(std::current_exception(), published,
-                   head->active_file().path());
-      return;
     }
     commit_delay_.on_sync_end(std::chrono::steady_clock::now() - sync_start);
   }
