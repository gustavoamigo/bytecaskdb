A group commit whose fdatasync fails, with no memory to publish the degraded
state, gives its writers std::bad_alloc in the I/O error's place. Reverts #623.
Guarded-by: "alloc sweep: put whose fdatasync fails"

diff --git a/bytecaskdb/db_commit.cpp b/bytecaskdb/db_commit.cpp
index 4093733..b8bcbe1 100644
--- a/bytecaskdb/db_commit.cpp
+++ b/bytecaskdb/db_commit.cpp
@@ -412,12 +412,10 @@ void DB::flush_failed(std::exception_ptr ex,
     std::lock_guard<std::mutex> lk{durable_mu_};
     flush_error_ = std::move(ex);
   }
-  degrade_from(published, [&] {
-    return std::format(
-        "commit fdatasync failed on '{}': bytes in page cache but "
-        "durability not confirmed. Call resume() to recover.",
-        active_path.string());
-  });
+  store_state(published->degraded_copy(std::format(
+      "commit fdatasync failed on '{}': bytes in page cache but "
+      "durability not confirmed. Call resume() to recover.",
+      active_path.string())));
 }
 
