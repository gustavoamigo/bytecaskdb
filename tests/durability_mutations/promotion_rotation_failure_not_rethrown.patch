degraded state, throws std::bad_alloc in the I/O error's place. Reverts #618.
Guarded-by: "alloc sweep: set_mode(Leader) whose rotation cannot create a file"

diff --git a/bytecaskdb/db_replication.cpp b/bytecaskdb/db_replication.cpp
index 0eac211..851b6c0 100644
--- a/bytecaskdb/db_replication.cpp
+++ b/bytecaskdb/db_replication.cpp
@@ -108,12 +108,12 @@ void DB::set_mode(Mode mode) {
         try {
           rotation = prepare_rotation(t);
         } catch (...) {
-          degrade_or_refuse([&] {
+          [&] {
             t.apply_degrade(
                 "set_mode(Leader) rotation file creation failed: call "
                 "resume().");
             store_state(current, std::move(t).persistent());
-          });
+          }();
           throw;
         }
         finish_rotation(t, std::move(rotation));
