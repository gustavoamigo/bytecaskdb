         } catch (...) {
-          degrade_or_refuse([&] {
+          [&] {
             store_state(current->degraded_copy(
                 "ingest rotation fdatasync failed: call resume() to "
                 "recover."));
-          });
+          }();
           throw;
         }
         PreparedRotation rotation;
