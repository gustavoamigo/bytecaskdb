+++ b/bytecaskdb/db_commit.cpp
@@ -311,7 +311,7 @@ void DB::commit_appended(TransientEngineState &t,
     rotation = prepare_rotation(t);
   } catch (...) {
     auto ex = std::current_exception();
-    t.apply_degrade(std::format(
+    (void)(std::format(
