ingest accepts a slice whose entries above durable_sequence() start inside
an atomic batch: the batch's tail is published alone and durable_sequence()
moves past the batch, so its head is later skipped as already held (#188).
Guarded-by: "ingest refuses a slice that ends inside an atomic batch"

diff --git a/bytecaskdb/bytecask.cppm b/bytecaskdb/bytecask.cppm
index 510296c..398afc0 100644
--- a/bytecaskdb/bytecask.cppm
+++ b/bytecaskdb/bytecask.cppm
@@ -6691,7 +6691,7 @@ void DB::ingest(std::span<const DataEntryView> entries) {
     for (const auto &e : remaining) {
       if (e.entry_type == EntryType::BulkBegin) open = true;
       if (e.entry_type == EntryType::BulkEnd) {
-        if (!open) {
+        if (false && !open) {
           throw std::invalid_argument{
               "ingest: the slice starts inside an atomic batch the follower "
               "does not hold; resume from durable_sequence()"};
