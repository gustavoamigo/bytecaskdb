+++ b/bytecaskdb/db_degraded.cpp
@@ -44,7 +44,6 @@ void DB::sync_active_file(TransientEngineState &t,
           caller, t.active_file().path().string()));
       store_state(current, std::move(t).persistent());
     } catch (...) {
-      refuse_writes();
     }
     throw;
   }
