A throw after a batch reached the file fails the batch but leaves the
engine writable, so the next write appends over bytes nothing published.
Reverts #364.
Guarded-by: "refuse writes: a throw after the append refuses writes until resume()"

diff --git a/bytecaskdb/db_commit.cpp b/bytecaskdb/db_commit.cpp
index 07f87ad..2648cca 100644
--- a/bytecaskdb/db_commit.cpp
+++ b/bytecaskdb/db_commit.cpp
@@ -236,7 +236,6 @@ auto DB::execute_group(std::span<Slot *> batch) -> std::size_t {
     for (auto *s : batch) {
       if (!s->err) s->err = ex;
     }
-    refuse_writes();
   }
   return batch.size();
 }
