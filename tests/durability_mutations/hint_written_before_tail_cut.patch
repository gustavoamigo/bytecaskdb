open writes a hint-less file's hint before it cuts the torn tail, so a cut
that fails, or a crash between the two, leaves a hint over a file that keeps
the tail, and no later open cuts it. Reverts #476.
Guarded-by: "DB recovery: open fails when the cut of a torn tail cannot be made or synced*"

diff --git a/bytecaskdb/db_recovery.cpp b/bytecaskdb/db_recovery.cpp
index 5016722..85c88df 100644
--- a/bytecaskdb/db_recovery.cpp
+++ b/bytecaskdb/db_recovery.cpp
@@ -244,6 +244,7 @@ auto DB::recovery_prepare_files(EngineState &s)
       // crash interrupted, would keep the tail for good.
       auto stage = stage_hint(*data_file, OnDamage::Stop);
       recovery_check_tail(*data_file, stage.end, data_paths);
+      write_hint(stage, dir_, p.stem().string());
       if (stage.end < data_file->size()) {
         // The file is closed before it is cut, so no mapping or open file
         // spans the bytes that go. Same file_id on the reopen, deliberately.
@@ -255,7 +256,6 @@ auto DB::recovery_prepare_files(EngineState &s)
         truncate_durably(p, stage.end);
         data_file = openDataFileForRead(p, io_backend_, pool_, file_id);
       }
-      write_hint(std::move(stage), dir_, p.stem().string());
     }
     files_t.set(file_id, data_file);
 
