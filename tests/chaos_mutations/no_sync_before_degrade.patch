A failed append degrades without first syncing what the page cache holds
(classes B1-B3). resume() now rewrites and syncs the tail before it trusts
it (#240), so nothing it publishes depends on that sync.
Expected: NOT caught.
diff --git a/bytecaskdb/db_commit.cpp b/bytecaskdb/db_commit.cpp
index 23e02a8..861a0db 100644
--- a/bytecaskdb/db_commit.cpp
+++ b/bytecaskdb/db_commit.cpp
@@ -207,7 +207,6 @@ auto DB::execute_group(std::span<Slot *> batch) -> std::size_t {
     file.append_entries(all_entries, io_offsets, scratch_bytes_);
   } catch (...) {
     auto ex = std::current_exception();
-    try { file.sync(); } catch (...) {}
     counters_.io_errors.fetch_add(1, std::memory_order_relaxed);
     // An append that failed partway leaves the chunks it wrote in the file,
     // unpublished: the next write must not be appended after them.
